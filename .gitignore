# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Notebook/runtime cache files
.ipynb_checkpoints/

# Local virtual environments
.venv/
venv/
env/

# Large generated simulation datasets.
# The public final CSV is tracked with Git LFS; other generated files remain ignored.
results/simulated_data/*
!results/simulated_data/SA_SAML_D.csv
!results/simulated_data/SA_SAML_D_sample.csv
!results/simulated_data/SA_SAML_D_data_dictionary.csv
!results/simulated_data/SA_SAML_D_schema.json

# Excel workbooks are not part of the public output; use one CSV per table.
results/insights/*.xlsx

# Internal audit export is intentionally not part of the public repository.
results/insights/feature_audit/SA_SAML_D_full_audit.csv

# Separate socioeconomic plotting work, not part of the core simulation framework.
results/aml_context_plots/

# Local paper drafting files are intentionally kept outside the public simulation repository.
paper/

# Runtime logs are generated per run. Keep folder placeholders only.
logs/**/*.log

# Backup of broken local Git metadata, if this folder was moved from OneDrive.
.git_broken_backup/

# Local OS/editor files
.DS_Store
Thumbs.db
desktop.ini

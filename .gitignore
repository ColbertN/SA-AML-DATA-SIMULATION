# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Notebook/runtime cache files
.ipynb_checkpoints/

# Local virtual environments
.venv/
venv/
env/

# Very large generated simulation datasets.
# These files are regenerated by scripts/main.py and are too large for normal GitHub pushes.
results/simulated_data/

# Separate socioeconomic plotting work, not part of the core simulation framework.
results/aml_context_plots/

# Runtime logs are generated per run. Keep folder placeholders only.
logs/**/*.log

# Backup of broken local Git metadata, if this folder was moved from OneDrive.
.git_broken_backup/

# Local OS/editor files
.DS_Store
Thumbs.db
desktop.ini
